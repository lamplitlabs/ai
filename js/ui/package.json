{
  "name": "lamplit-ai-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ai.lamplitlabs.com - the Lamplit Labs AI landing page (React 19 + Tailwind CSS 4, Vite). The models it shows are trained, measured and published elsewhere; a producer writes src/data/site.json and this package is the site's source and build.",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/sitemap.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint:js": "node scripts/check-unused-exports.mjs",
    "preview:static": "node scripts/preview-static.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.20.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "typescript": "~5.7.3",
    "vite": "^6.2.0",
    "vitest": "^4.1.12"
  }
}
